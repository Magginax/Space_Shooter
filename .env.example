# Copy this file to .env and fill in the values from
# Supabase dashboard -> Project Settings -> API.
# Only variables starting with VITE_ are included in the browser code.
# The publishable (anon) key is meant to be public; the database rules in
# supabase/schema.sql decide what it can do. Never put the secret/service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
